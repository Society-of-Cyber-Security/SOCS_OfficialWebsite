# Required for database-backed API routes
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/socs

# Required for authentication. Use separate, random values for each secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# Google OAuth client ID (use the same ID for the server and browser)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Required for contact form submissions to Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Set to the deployed origin for correct Open Graph image URLs
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: use Vercel Blob for persistent gallery uploads on serverless hosts
BLOB_READ_WRITE_TOKEN=

# Optional; defaults to the same-origin /api routes
NEXT_PUBLIC_API_URL=/api
